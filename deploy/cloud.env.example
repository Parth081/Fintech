# Copy to deploy/.env. Never commit real values. Synthetic-data demo only.
# --- access ---------------------------------------------------------------------------------------
# 0.0.0.0 exposes the proxy beyond the host (use with PROXY_MODE=auth and HTTPS)
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
PROXY_TLS_PORT=8443
# a domain name (e.g. demo.example.com) turns on automatic HTTPS (ports 80/443 must be reachable)
SITE_ADDRESS=:80
# open | auth
PROXY_MODE=open
BASIC_AUTH_USER=
# Single-quote the bcrypt hash so the dollar signs are not interpolated, e.g. BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_HASH=
# --- demo ------------------------------------------------------------------------------------------
# CHANGE THIS: the built-in default PIN is public in this repository
BOOTH_STAFF_PIN=
AMBIENT_RATE=3
# --- optional: Postgres (add --profile postgres) ---------------------------------------------------
POSTGRES_PASSWORD=
# postgres://ct:<POSTGRES_PASSWORD>@postgres:5432/ledger   (empty = embedded PGlite)
DATABASE_URL=
# --- optional: Redpanda (add --profile redpanda) ---------------------------------------------------
# local | kafka
BUS=local
# --- optional: Claude-phrased explainer (needs outbound internet; leave off for the demo) -----------
ASSISTANT_LLM=off
ANTHROPIC_API_KEY=
