<mxfile host="app.diagrams.net" type="device"><diagram id="simple" name="1. Simple view (for everyone)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="simple-1" value="Global Fintech Control Tower: how one payment travels" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="simple-2" value="Read left to right. Every box is a real running service. Everything uses synthetic (made-up) data: no real customers, banks or money." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1200" height="24" as="geometry"/></mxCell><mxCell id="simple-3" value="&lt;b&gt;1. Customer sends money&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;A marketplace pays a seller in another country (e.g. USD to INR)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-4" value="&lt;b&gt;2. Check who they are&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Identity check (KYC) and sanctions-list screening&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="256" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-5" value="&lt;b&gt;3. Check it is safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fraud score and money-laundering (AML) pattern checks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="472" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-6" value="&lt;b&gt;4. Get the best exchange rate&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;FX quote: compare rates, lock the price&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="688" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-7" value="&lt;b&gt;5. Pick the best route&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Cheapest, fastest, most reliable provider. Switch automatically if one fails&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="904" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-8" value="&lt;b&gt;6. Deliver the money&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Payment network sends it using ISO 20022 bank messages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-9" value="&lt;b&gt;7. Balance the books&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Double-entry ledger + reconciliation: nothing lost, nothing paid twice&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1336" y="250" width="180" height="120" as="geometry"/></mxCell><mxCell id="simple-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-3" target="simple-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-4" target="simple-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-5" target="simple-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-6" target="simple-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-7" target="simple-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-8" target="simple-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-16" value="&lt;b&gt;Scenario: fraud ring attack&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Suspicious burst of transfers is caught and held&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="472" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="simple-17" value="presenter triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-16" target="simple-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-18" value="&lt;b&gt;Scenario: currency spike&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Rate jumps; system compares lock now vs. wait&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="688" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="simple-19" value="presenter triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-18" target="simple-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-20" value="&lt;b&gt;Scenario: provider outage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;A provider fails; traffic re-routes, no payment lost&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="904" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="simple-21" value="presenter triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-20" target="simple-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-22" value="&lt;b&gt;Demo control room&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Presenter tablet: start scenarios, pause, reset in 10 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="396" height="80" as="geometry"/></mxCell><mxCell id="simple-23" value="starts normal traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-22" target="simple-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-24" value="&lt;b&gt;Decision log&lt;/b&gt;: every step writes down what it decided and why (inputs, rule or model used, reason codes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1476" height="56" as="geometry"/></mxCell><mxCell id="simple-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-4" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-5" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-6" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-7" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-8" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="simple-9" target="simple-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-31" value="&lt;b&gt;Live screens&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;World map of payments, step-by-step pipeline, risk and cost dashboards&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="256" y="560" width="396" height="90" as="geometry"/></mxCell><mxCell id="simple-32" value="&lt;b&gt;AI assistant&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Answers questions like &quot;Why was this payment blocked?&quot; using only the decision log, never guesses&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="904" y="560" width="396" height="90" as="geometry"/></mxCell><mxCell id="simple-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-24" target="simple-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-24" target="simple-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-35" value="shows answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="simple-32" target="simple-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="simple-36" value="&lt;b&gt;Colour key&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1562" y="250" width="220" height="24" as="geometry"/></mxCell><mxCell id="simple-37" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="282" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-38" value="Start / demo controls" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="280" width="260" height="24" as="geometry"/></mxCell><mxCell id="simple-39" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="312" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-40" value="Risk and compliance checks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="310" width="260" height="24" as="geometry"/></mxCell><mxCell id="simple-41" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="342" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-42" value="Moving the money" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="340" width="260" height="24" as="geometry"/></mxCell><mxCell id="simple-43" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="372" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-44" value="Accounting (source of truth)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="370" width="260" height="24" as="geometry"/></mxCell><mxCell id="simple-45" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="402" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-46" value="Records and AI explanations" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="400" width="260" height="24" as="geometry"/></mxCell><mxCell id="simple-47" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1562" y="432" width="26" height="20" as="geometry"/></mxCell><mxCell id="simple-48" value="What visitors see and trigger" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1598" y="430" width="260" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tech" name="2. Technical architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tech-1" value="Technical architecture: event-driven services, one ledger, one decision log" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="tech-2" value="Every service reads an event, makes one decision, records why, and emits the next event. Screens and AI read only recorded data, never a script." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="24" as="geometry"/></mxCell><mxCell id="tech-3" value="A. Demo control" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1040" height="120" as="geometry"/></mxCell><mxCell id="tech-4" value="&lt;b&gt;Scenario orchestrator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Seeded traffic, time compression, fault injection (Go/Kotlin, scenarios in YAML)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="320" height="70" as="geometry"/></mxCell><mxCell id="tech-5" value="&lt;b&gt;Presenter console&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Trigger scenarios, pause, slow-mo, 10 s reset, safe mode&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="125" width="320" height="70" as="geometry"/></mxCell><mxCell id="tech-6" value="&lt;b&gt;Synthetic data generator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Seeded customer profiles, AMLSim-style laundering patterns&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="740" y="125" width="320" height="70" as="geometry"/></mxCell><mxCell id="tech-7" value="&lt;b&gt;B. Event backbone&lt;/b&gt;: Redpanda (laptop) / Kafka (cloud). Ordered, replayable payment events, partitioned by payment ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1040" height="50" as="geometry"/></mxCell><mxCell id="tech-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-4" target="tech-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-5" target="tech-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-6" target="tech-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-11" value="C1. Risk and compliance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="500" height="280" as="geometry"/></mxCell><mxCell id="tech-12" value="&lt;b&gt;KYC and sanctions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fuzzy name match vs. fictional lists&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="220" height="64" as="geometry"/></mxCell><mxCell id="tech-13" value="&lt;b&gt;Fraud scoring&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Python, gradient-boosted model, reason codes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="220" height="64" as="geometry"/></mxCell><mxCell id="tech-14" value="&lt;b&gt;AML monitoring&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Typology rules: fan-in, fan-out, cycles&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="460" height="56" as="geometry"/></mxCell><mxCell id="tech-15" value="&lt;b&gt;Decision engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Policy-as-code: approve / hold / reject, versioned policies&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="460" height="64" as="geometry"/></mxCell><mxCell id="tech-16" value="C2. Money movement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="580" y="320" width="500" height="280" as="geometry"/></mxCell><mxCell id="tech-17" value="&lt;b&gt;FX service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Rates, spreads, quote and lock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="360" width="220" height="64" as="geometry"/></mxCell><mxCell id="tech-18" value="&lt;b&gt;Smart routing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Cost / success / latency scoring, circuit breakers, failover&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="220" height="64" as="geometry"/></mxCell><mxCell id="tech-19" value="&lt;b&gt;Settlement simulator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Fictional rails, ISO 20022 (pacs.008, camt.053)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="440" width="220" height="56" as="geometry"/></mxCell><mxCell id="tech-20" value="&lt;b&gt;Reconciliation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Match statements to ledger, flag breaks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="220" height="56" as="geometry"/></mxCell><mxCell id="tech-21" value="&lt;b&gt;Double-entry ledger&lt;/b&gt; (PostgreSQL)&lt;br&gt;&lt;span style='font-size:11px'&gt;Source of truth: debits always equal credits&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="515" width="460" height="64" as="geometry"/></mxCell><mxCell id="tech-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="tech-7" target="tech-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="tech-7" target="tech-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-24" value="approved payments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-15" target="tech-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-17" target="tech-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-18" target="tech-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-19" target="tech-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-20" target="tech-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-29" value="&lt;b&gt;D. Decision trace store + read models&lt;/b&gt; (PostgreSQL): inputs, rule/model version, outputs, reason codes, latency" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="760" height="56" as="geometry"/></mxCell><mxCell id="tech-30" value="&lt;b&gt;Metrics and traces&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;OpenTelemetry, Prometheus&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="630" width="260" height="56" as="geometry"/></mxCell><mxCell id="tech-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tech-15" target="tech-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tech-21" target="tech-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-33" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="tech-21" target="tech-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-34" value="E. What people see" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1040" height="130" as="geometry"/></mxCell><mxCell id="tech-35" value="&lt;b&gt;WebSocket gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Pushes live updates&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="755" width="220" height="70" as="geometry"/></mxCell><mxCell id="tech-36" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;React; deck.gl/MapLibre globe; pipeline; dashboards&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="755" width="260" height="70" as="geometry"/></mxCell><mxCell id="tech-37" value="&lt;b&gt;AI explainer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;LLM + read-only tools over traces; cached offline answers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="755" width="240" height="70" as="geometry"/></mxCell><mxCell id="tech-38" value="&lt;b&gt;Ops dashboards&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Grafana: system health shown live&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="755" width="220" height="70" as="geometry"/></mxCell><mxCell id="tech-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-29" target="tech-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-35" target="tech-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-29" target="tech-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-42" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-37" target="tech-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tech-30" target="tech-38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tech-44" value="Deployment (same containers)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="300" height="300" as="geometry"/></mxCell><mxCell id="tech-45" value="&lt;b&gt;Booth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Docker Compose on 1 laptop, works with Wi-Fi off. Hot-spare laptop + recorded backup run&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="260" height="100" as="geometry"/></mxCell><mxCell id="tech-46" value="&lt;b&gt;Cloud&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Kubernetes for remote demos and load tests. Measured throughput only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="260" height="100" as="geometry"/></mxCell><mxCell id="tech-47" value="Design rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="1120" y="420" width="300" height="300" as="geometry"/></mxCell><mxCell id="tech-48" value="1. Payment = state machine; every change is an event&lt;br&gt;2. Every decision is recorded with its reason&lt;br&gt;3. Money moves only as balanced ledger entries&lt;br&gt;4. Idempotency keys: retries never pay twice&lt;br&gt;5. Fictional brands; label screens &quot;Simulation&quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1135" y="455" width="275" height="250" as="geometry"/></mxCell><mxCell id="tech-49" value="&lt;b&gt;Colour key&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="750" width="220" height="24" as="geometry"/></mxCell><mxCell id="tech-50" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="782" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-51" value="Demo control and event flow" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="780" width="260" height="24" as="geometry"/></mxCell><mxCell id="tech-52" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="812" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-53" value="Risk and compliance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="810" width="260" height="24" as="geometry"/></mxCell><mxCell id="tech-54" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="842" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-55" value="Money movement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="840" width="260" height="24" as="geometry"/></mxCell><mxCell id="tech-56" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="872" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-57" value="Ledger (source of truth)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="870" width="260" height="24" as="geometry"/></mxCell><mxCell id="tech-58" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="902" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-59" value="Data and records" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="900" width="260" height="24" as="geometry"/></mxCell><mxCell id="tech-60" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="932" width="26" height="20" as="geometry"/></mxCell><mxCell id="tech-61" value="User-facing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1156" y="930" width="260" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="miles" name="3. Milestones"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="miles-1" value="Delivery milestones: event-ready in 14 weeks, then grow on demand" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="36" as="geometry"/></mxCell><mxCell id="miles-2" value="Each milestone ends with something you can show. Red diamonds are go / no-go gates: if a gate slips, cut a scenario, never the rehearsals. Weeks are estimates to confirm in M0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1700" height="24" as="geometry"/></mxCell><mxCell id="miles-3" value="&lt;b&gt;Phase 0: Discovery&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="210" height="36" as="geometry"/></mxCell><mxCell id="miles-4" value="&lt;b&gt;Phase 1: Engine slice&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="85" width="670" height="36" as="geometry"/></mxCell><mxCell id="miles-5" value="&lt;b&gt;Phase 2: Event-ready MVP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="85" width="670" height="36" as="geometry"/></mxCell><mxCell id="miles-6" value="&lt;b&gt;Phase 3: Grow on demand&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="85" width="210" height="36" as="geometry"/></mxCell><mxCell id="miles-7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="165" as="sourcePoint"/><mxPoint x="1870" y="165" as="targetPoint"/></mxGeometry></mxCell><mxCell id="miles-8" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="131.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-9" value="&lt;b&gt;Week 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-10" value="&lt;b&gt;M0 · Plan and storyboard&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-11" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• Pick first event and date&lt;br&gt;• Pick 2-3 buyer segments&lt;br&gt;• Choose 3 scenarios and corridors&lt;br&gt;• Storyboard + screen mock-ups&lt;br&gt;• Decide tech stack&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Clickable storyboard&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Gate 1: sales and 2 friendly bankers approve the story&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Product owner + architect&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-12" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="361.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-13" value="&lt;b&gt;Week 4&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-14" value="&lt;b&gt;M1 · Walking skeleton&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-15" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• Repo, CI, Docker Compose&lt;br&gt;• Event backbone running&lt;br&gt;• Payment state machine&lt;br&gt;• Every step as a simple stub&lt;br&gt;• First basic screen&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;One payment travels from start to settled on screen&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Runs on one laptop with Wi-Fi off&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Tech lead&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="270" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-16" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="591.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-17" value="&lt;b&gt;Week 6&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-18" value="&lt;b&gt;M2 · Money core&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-19" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• Double-entry ledger&lt;br&gt;• FX service (rates, spreads)&lt;br&gt;• Routing over 3 fictional providers&lt;br&gt;• Settlement simulator (ISO 20022)&lt;br&gt;• Synthetic traffic generator&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Thousands of payments across 3 corridors&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ 10,000 payments: debits = credits, no duplicates on retry&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Backend engineers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-20" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="821.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-21" value="&lt;b&gt;Week 8&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="730" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-22" value="&lt;b&gt;M3 · First scenario live&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-23" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• Provider-outage scenario&lt;br&gt;• Circuit breakers + failover&lt;br&gt;• World map + pipeline view&lt;br&gt;• Presenter console&lt;br&gt;• 10-second reset&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Scenario 1 demo-able end to end&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Gate 2: outage runs offline 10 times in a row; ledger balances&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Tech lead + front end&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="730" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-24" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1051.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-25" value="&lt;b&gt;Week 11&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-26" value="&lt;b&gt;M4 · Risk and compliance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-27" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• KYC + sanctions screening&lt;br&gt;• Fraud model with reason codes&lt;br&gt;• AML rules (fan-in / fan-out)&lt;br&gt;• Decision engine + investigator view&lt;br&gt;• Fraud-ring and FX-spike scenarios&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;All 3 scenarios run&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Every decision has a trace; payments SME signs off realism&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; ML engineer + backend&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-28" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1281.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-29" value="&lt;b&gt;Week 13&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1190" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-30" value="&lt;b&gt;M5 · AI explainer and booth mode&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-31" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• AI assistant (read-only tools)&lt;br&gt;• Suggested questions&lt;br&gt;• Cached offline answers&lt;br&gt;• 90-second attract loop&lt;br&gt;• Lead capture + analytics&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Visitors can ask &quot;why?&quot; and get a cited answer&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ 100+ test questions per scenario; every number matches the trace&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; ML engineer + designer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1190" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-32" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1511.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-33" value="&lt;b&gt;Week 14&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1420" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-34" value="&lt;b&gt;M6 · Show-ready&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1420" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-35" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• 2 dress rehearsals on event hardware&lt;br&gt;• Hot-spare laptop&lt;br&gt;• Recorded backup run&lt;br&gt;• Legal review of booth copy&lt;br&gt;• Presenter training&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Ready for the conference floor&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Gate 3: no hard failures in rehearsals&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Whole team&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1420" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-36" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1741.0" y="151" width="28" height="28" as="geometry"/></mxCell><mxCell id="miles-37" value="&lt;b&gt;After event&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1650" y="128" width="210" height="20" as="geometry"/></mxCell><mxCell id="miles-38" value="&lt;b&gt;M7 · Grow on demand&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="195" width="210" height="44" as="geometry"/></mxCell><mxCell id="miles-39" value="&lt;b&gt;What we build&lt;/b&gt;&lt;br&gt;• Cloud deployment + load-test mode&lt;br&gt;• Deep-dive modules per domain&lt;br&gt;• Prospect-specific scenarios&lt;br&gt;• New domains only with a sales case&lt;br&gt;&lt;br&gt;&lt;b&gt;What we can show&lt;/b&gt;&lt;br&gt;Reusable sales asset between events&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;✔ Measured throughput published; a prospect scenario built in under 1 week&lt;br&gt;&lt;br&gt;&lt;span style='color:#666666'&gt;&lt;b&gt;Lead:&lt;/b&gt; Owner + 1-2 engineers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1650" y="245" width="210" height="360" as="geometry"/></mxCell><mxCell id="miles-40" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="80" height="24" as="geometry"/></mxCell><mxCell id="miles-41" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="22" height="22" as="geometry"/></mxCell><mxCell id="miles-42" value="Milestone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="654" width="110" height="24" as="geometry"/></mxCell><mxCell id="miles-43" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="655" width="22" height="22" as="geometry"/></mxCell><mxCell id="miles-44" value="Go / no-go gate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="654" width="200" height="24" as="geometry"/></mxCell><mxCell id="miles-45" value="Team: architect/tech lead, 2 backend, 1 front-end/data-viz, 1 ML/data (from week 5), designer (0.5-1), payments SME (0.25), product owner (0.5): about 6 full-time equivalents." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1500" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>